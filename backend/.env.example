OPENAI_API_KEY=your_openai_key
SEC_USER_AGENT=YourName contact@email.com
CHROMA_PATH=./chroma_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
FRED_API_KEY=your_fred_api_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
MAX_TOKEN_BUDGET_GRANT=200000

# --- Observability (structured logging + metrics) ---------------------------
# Works with no external infrastructure: events are one JSON line per stage on
# stdout, metrics are aggregated in-process and exposed at GET /api/metrics.
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true            # false = human-readable log lines for local dev
RELEASE_VERSION=         # git sha / release tag; stamped on every event when set
REDACT_PROMPT_CONTENT=false  # true drops prompt/question text from logs entirely

# Arize AX tracing (optional — leave blank to disable). Get these from app.arize.com > Settings.
ARIZE_SPACE_ID=your_arize_space_id
ARIZE_API_KEY=your_arize_api_key
ARIZE_PROJECT_NAME=financial-research-copilot
ARIZE_REGION=US
# Arize management API (evals/push_to_arize.py only) — publishing eval runs as
# experiments. Separate from trace ingestion. Use a service-account key; leave blank
# to skip publishing. ARIZE_API_HOST is api.arize.com for GCP-cluster accounts
# (us-central-1a) or api.<region>.arize.com for AWS accounts (e.g. us-east-1b).
ARIZE_SVC_KEY=your_arize_service_account_key
ARIZE_API_HOST=api.arize.com
