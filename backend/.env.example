OPENAI_API_KEY=your_openai_key
SEC_USER_AGENT=YourName contact@email.com
CHROMA_PATH=./chroma_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=5
FRED_API_KEY=your_fred_api_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# --- Shared usage/cost controls ---------------------------------------------
# Access approval + per-user token budgets were removed: any authenticated user
# can use the copilot immediately, bounded by ONE shared monthly dollar budget
# plus lightweight per-user safeguards. The monthly budget resets automatically
# by calendar month (UTC) — no cron job. Cost is derived from real token usage
# with prompt/completion priced separately.
MONTHLY_BUDGET_USD=20.0        # shared app-wide budget for the whole month
USER_DAILY_BUDGET_USD=1.0      # per-user daily dollar cap (0 disables)
USER_DAILY_TOKEN_LIMIT=0       # optional per-user daily token cap (0 disables)
RATE_LIMIT_PER_MINUTE=20       # per-user request rate limit (0 disables)
MAX_COST_PER_QUERY_USD=0.05    # reserved up front per query; reconciled to actual
# Optional model-price overrides ($ per 1K tokens) for the active LLM_MODEL.
# Leave 0 to use the built-in price table in app/core/observability.py.
COST_INPUT_PER_1K=0.0
COST_OUTPUT_PER_1K=0.0
# Policy flags (explicit + configurable):
BUDGET_FAIL_OPEN=true             # true = allow + record on a budget-infra error; false = block (503)
INGEST_COUNTS_TOWARD_BUDGET=true  # ingestion (embedding) spend counts against the shared budget

# --- Online evaluators (cheap, non-LLM per-request quality signals) ----------
# Emits retrieval-drift + response-regression signals as logs + /api/metrics
# counters/histograms (eval.*). No extra model calls, no cost.
ONLINE_EVAL_ENABLED=true

# --- Observability (structured logging + metrics) ---------------------------
# Works with no external infrastructure: events are one JSON line per stage on
# stdout, metrics are aggregated in-process and exposed at GET /api/metrics.
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true            # false = human-readable log lines for local dev
RELEASE_VERSION=         # git sha / release tag; stamped on every event when set
REDACT_PROMPT_CONTENT=false  # true drops prompt/question text from logs entirely

# Arize AX tracing (optional — leave blank to disable). Get these from app.arize.com > Settings.
ARIZE_SPACE_ID=your_arize_space_id
ARIZE_API_KEY=your_arize_api_key
ARIZE_PROJECT_NAME=financial-research-copilot
ARIZE_REGION=US
# Offline eval harness (evals/) — judge model for RAGAS + custom LLM judges. Use a
# stronger model than LLM_MODEL so it isn't grading its own output.
EVAL_JUDGE_MODEL=gpt-4o
# Arize management API (evals/push_to_arize.py only) — publishing eval runs as
# experiments. Separate from trace ingestion. Use a service-account key; leave blank
# to skip publishing. ARIZE_API_HOST is api.arize.com for GCP-cluster accounts
# (us-central-1a) or api.<region>.arize.com for AWS accounts (e.g. us-east-1b).
ARIZE_SVC_KEY=your_arize_service_account_key
ARIZE_API_HOST=api.arize.com
